      "id": 1,
      "title": "Agent Orchestration & Explainability Signals",
      "type": "row"
    },
    {
      "title": "Tool Execution Latency (p50, p95 by tool)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, tool) (rate(xplainai_tool_execution_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 {{tool}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(xplainai_tool_execution_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 {{tool}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Tool Invocations by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (tool, status) (rate(xplainai_tool_execution_duration_seconds_count[1m]))",
          "legendFormat": "{{tool}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "title": "EGI Grounding Score (Average)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 9 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(xplainai_egi_score_sum[5m])) / sum(rate(xplainai_egi_score_count[5m]))",
          "legendFormat": "EGI Mean",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      }
    },
    {
      "title": "Graph Nodes Distribution",
      "type": "histogram",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 9 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(xplainai_graph_nodes_count_bucket[5m])",
          "legendFormat": "{{le}} nodes",
          "refId": "A"
        }
      ]
    }
  ],
