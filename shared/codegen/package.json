{
  "name": "@neural-navigator/codegen",
  "version": "0.1.0",
  "private": true,
  "description": "Contract validation and client generation for both languages.",
  "scripts": {
    "lint": "node ./lint-contracts.mjs",
    "generate": "pnpm generate:ts && pnpm generate:zod",
    "generate:ts": "openapi-typescript ../contracts/openapi/openapi.yaml -o ../packages/contracts-ts/src/generated/http.ts",
    "generate:zod": "ts-to-zod ../packages/contracts-ts/src/generated/http.ts ../packages/contracts-ts/src/generated/http.zod.ts --skipValidation",
    "diff": "redocly diff ../contracts/openapi/openapi.yaml"
  },
  "devDependencies": {
    "@asyncapi/cli": "^2.6.0",
    "@redocly/cli": "^1.25.0",
    "openapi-typescript": "^7.4.0",
    "ts-to-zod": "^3.13.0"
  }
}
