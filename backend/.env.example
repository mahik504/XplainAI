# Backend overrides. Prefer also keeping a root `.env`.
# Never commit real secrets.

APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=console
PROJECT_NAME=XplainAI

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Model providers ---------------------------------------------------------
# openai = production streaming client (REQUIRES OPENAI_API_KEY — fails fast if missing)
# echo   = offline deterministic stub (set explicitly; never used as a silent fallback)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
DEFAULT_CHAT_MODEL=gpt-4.1-mini
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

JWT_SECRET=change-me
AUTH_REQUIRED=false

WS_HEARTBEAT_INTERVAL_SECONDS=20
WS_MAX_CONNECTIONS_PER_USER=5
WS_MESSAGE_MAX_BYTES=65536

OTEL_SERVICE_NAME=xplainai-api
