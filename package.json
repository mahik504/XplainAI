{
  "name": "neural-navigator",
  "version": "2.1.0",
  "private": true,
  "description": "XplainAI — Explainability OS monorepo (internal package namespace: neural-navigator).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @neural-navigator/web dev",
    "build": "pnpm --filter @neural-navigator/contracts build && pnpm --filter @neural-navigator/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "contracts:lint": "pnpm --filter @neural-navigator/codegen lint",
    "contracts:gen": "pnpm --filter @neural-navigator/codegen generate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
