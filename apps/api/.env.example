# =============================================================================
# XplainAI Backend API Configuration (apps/api/.env.example)
# Copy to `.env` in `apps/api` or maintain `.env` at repository root.
# NEVER commit real secrets or credentials to version control.
# =============================================================================

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console
PROJECT_NAME=XplainAI
VERSION=3.0.0

API_HOST=0.0.0.0
API_PORT=8000
API_ROOT_PATH=
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Datastores (PostgreSQL 16 with pgvector & Redis 7) -----------------------
POSTGRES_DSN=postgresql+asyncpg://navigator:navigator@localhost:5432/navigator
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30.0
POSTGRES_POOL_RECYCLE=1800
REDIS_URL=redis://localhost:6379/0

# --- Hybrid RAG & Vector Embeddings -------------------------------------------
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
VECTOR_TOP_K=10
HYBRID_SEARCH_ALPHA=0.6
RERANKER_ENABLED=false

# --- LLM Providers & Omni Router (Backend-Only) ------------------------------
# Supported: "openai", "omni_router", "echo" (offline stub)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OMNI_ROUTER_API_KEY=
OMNI_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OMNI_ROUTER_SITE_URL=https://xplain.ai
OMNI_ROUTER_APP_NAME=XplainAI
DEFAULT_CHAT_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

# --- Public Demo Mode & Cost Circuit Breakers --------------------------------
DEMO_MODE_ENABLED=true
BUDGET_DAILY_LIMIT_USD=10.00
BUDGET_HOURLY_LIMIT_USD=2.00
BUDGET_IP_DAILY_LIMIT_USD=0.50
BUDGET_CIRCUIT_BREAKER_ENABLED=true

# --- LangGraph Multi-Agent Runtime -------------------------------------------
LANGGRAPH_CHECKPOINT_BACKEND=memory
AGENT_MAX_STEPS=32
AGENT_STEP_TIMEOUT_SECONDS=120.0
DEFAULT_RUN_MODE=deep_research
CONVERSATION_DB_PATH=.data/conversations.db

# --- Authentication & Session Security ---------------------------------------
AUTH_REQUIRED=false
JWT_SECRET=change-me-to-a-secure-random-32-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Real-Time WebSocket -----------------------------------------------------
WS_HEARTBEAT_INTERVAL_SECONDS=20.0
WS_MAX_CONNECTIONS_PER_USER=5
WS_MESSAGE_MAX_BYTES=65536

# --- Optional External Research APIs -----------------------------------------
NEWSDATA_API_KEY=
OPENWEATHER_API_KEY=

# --- Observability -----------------------------------------------------------
OTEL_SERVICE_NAME=xplainai-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
