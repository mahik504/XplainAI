# =============================================================================
# XplainAI v1.0 — environment template
# Copy to `.env` (repo root and/or backend/) and fill secrets.
# NEVER commit a populated `.env`.
# =============================================================================

# --- Required for OpenAI demo / production -----------------------------------
# Production path (recommended for finals when a key is available):
LLM_PROVIDER=openai
OPENAI_API_KEY=
DEFAULT_CHAT_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1

# Offline stub only when set explicitly (openai never falls back silently):
# LLM_PROVIDER=echo

# --- Runtime -----------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=console
PROJECT_NAME=XplainAI

# --- Backend HTTP ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- LLM tuning --------------------------------------------------------------
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

# --- Auth (local defaults; rotate for any shared deploy) ---------------------
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REQUIRED=false

# --- Datastores (reserved; not required for local demo) ----------------------
# POSTGRES_DSN=postgresql+asyncpg://navigator:navigator@localhost:5432/navigator
# REDIS_URL=redis://localhost:6379/0

# --- WebSocket ---------------------------------------------------------------
WS_HEARTBEAT_INTERVAL_SECONDS=20
WS_MAX_CONNECTIONS_PER_USER=5
WS_MESSAGE_MAX_BYTES=65536

# --- Observability (optional) ------------------------------------------------
OTEL_SERVICE_NAME=xplainai-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Frontend (Vite — only VITE_* is exposed to the browser; never secrets) --
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000/ws/v1
# VITE_WS_TOKEN=
