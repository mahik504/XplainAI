# =============================================================================
# XplainAI v3.0.0 — Production Environment Template
# Copy to `.env` in the repository root and populate secret values.
# NEVER commit a populated `.env` file to version control.
# =============================================================================

# --- Core Application & Runtime -----------------------------------------------
APP_ENV=local
PROJECT_NAME=XplainAI
VERSION=3.0.0
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Backend HTTP & Network ---------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_ROOT_PATH=
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Omni Router & Cost Circuit Breakers (Backend Only) -----------------------
# The public demo uses backend-only Omni Router integration with hard cost circuit breakers.
# The frontend NEVER receives or stores this key.
OMNI_ROUTER_API_KEY=
OMNI_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OMNI_ROUTER_DAILY_BUDGET_USD=10.00
OMNI_ROUTER_HOURLY_BUDGET_USD=2.00
OMNI_ROUTER_IP_BUDGET_USD=0.50

# --- LLM Providers & Inference Configuration ----------------------------------
# Supported providers: "openai", "echo" (offline stub).
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
DEFAULT_CHAT_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

# Optional Additional Model Providers
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Local / Private LLM (Ollama, LM Studio, vLLM for BYOK mode)
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_API_KEY=
CUSTOM_CHAT_MODEL=llama3.3

# --- Relational Database & Vector Store (PostgreSQL 16 + pgvector) ------------
POSTGRES_DSN=postgresql+asyncpg://navigator:navigator@localhost:5432/navigator
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30.0
POSTGRES_POOL_RECYCLE=1800

# --- Embeddings & Hybrid Vector RAG -------------------------------------------
# Supported embedding providers: "mock" (offline test), "openai", "fastembed"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
VECTOR_TOP_K=10
HYBRID_SEARCH_ALPHA=0.6
RERANKER_ENABLED=false

# --- Distributed Cache, Pub/Sub & Rate Limiting (Redis 7) --------------------
REDIS_URL=redis://localhost:6379/0

# --- Authentication & Session Security (Local Defaults) -----------------------
# In production, rotate JWT_SECRET to a secure 256-bit random key.
AUTH_REQUIRED=false
JWT_SECRET=change-me-to-a-secure-256-bit-random-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Multi-Agent LangGraph Runtime --------------------------------------------
LANGGRAPH_CHECKPOINT_BACKEND=memory
AGENT_MAX_STEPS=32
AGENT_STEP_TIMEOUT_SECONDS=120.0
DEFAULT_RUN_MODE=deep_research

# --- External Research APIs (Optional) ----------------------------------------
NEWSDATA_API_KEY=
OPENWEATHER_API_KEY=

# --- WebSocket Streaming Transport --------------------------------------------
WS_HEARTBEAT_INTERVAL_SECONDS=20.0
WS_MAX_CONNECTIONS_PER_USER=5
WS_MESSAGE_MAX_BYTES=65536

# --- Observability (OpenTelemetry / Prometheus) -------------------------------
OTEL_SERVICE_NAME=xplainai-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Frontend Client Configuration (apps/web) ---------------------------------
# NOTE: Only variables prefixed with VITE_ are bundled into client-side JavaScript.
# NEVER place backend API keys or secrets into VITE_* variables!
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws/v1
